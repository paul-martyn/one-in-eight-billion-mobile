{
  "name": "one-in-eight-billion-independent",
  "version": "0.1.0-experimental",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4192 --strictPort",
    "typecheck": "tsc -b",
    "verify:core": "npm run verify:engine",
    "test": "node --experimental-strip-types --test tests/*.test.mjs tests/core/*.test.mjs",
    "test:equivalence": "node --experimental-strip-types --test tests/core/regressions.test.mjs",
    "check": "npm run verify:engine && npm run typecheck && npm test",
    "build": "npm run verify:engine && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4193 --strictPort",
    "verify:build": "node --experimental-strip-types tools/harness/check-build.mjs",
    "verify:engine": "node tools/verify-engine.mjs",
    "test:oracle": "node --experimental-strip-types tools/verification/run-oracle-tests.mjs"
  },
  "dependencies": {
    "@fontsource/caveat": "5.3.0",
    "@fontsource/courier-prime": "5.3.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/rubik": "5.3.0",
    "motion": "14.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "acorn": "8.15.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
