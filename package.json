{
  "name": "one-in-eight-billion-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.16.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4190 --strictPort",
    "typecheck": "tsc -b",
    "verify:core": "node tools/verify-core.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run verify:core && npm run typecheck && npm test",
    "build": "npm run verify:core && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4191 --strictPort"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
